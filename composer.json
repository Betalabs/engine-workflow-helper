{
  "name": "betalabs/engine-workflow-helper",
  "description": "Package providing helpers for Engine Workflow creation",
  "keywords": ["api", "laravel", "rest", "workflow", "engine"],
  "license": "MIT",
  "authors": [
    {
      "name": "Betalabs Tecnologia LTDA.",
      "email": "betalabs@betalabs.com.br"
    }
  ],
  "require": {
    "php": "^8.2",
    "betalabs/engine-phpsdk": "^3.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "myclabs/php-enum": "^1.5"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Betalabs\\EngineWorkflowHelper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Betalabs\\EngineWorkflowHelper\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
